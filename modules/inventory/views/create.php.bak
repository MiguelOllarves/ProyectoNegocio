<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Toggle new inputs logic
        const selects = ['cat', 'brand'];
        selects.forEach(pref => {
            const select = document.getElementById(pref + '_select');
            const input = document.getElementById('new_' + (pref === 'cat' ? 'category' : pref));
            if(select && input) {
                select.addEventListener('change', function() {
                    if(this.value === 'new') {
                        input.classList.remove('hidden');
                        input.focus();
                    } else {
                        input.classList.add('hidden');
                        input.value = '';
                    }
                });
            }
        });

        // Dynamic Attributes logic
        const btnAdd = document.getElementById('add-attr-btn');
        const container = document.getElementById('attributes-container');
        const emptyMsg = document.getElementById('empty-attrs-msg');

        btnAdd.addEventListener('click', function() {
            if (emptyMsg) emptyMsg.style.display = 'none';
            
            const row = document.createElement('div');
            row.className = 'flex gap-3 items-center animate-fade-in-up bg-white p-2 rounded border border-gray-200 shadow-sm';
            row.innerHTML = `
                <div class="flex-1">
                    <input type="text" name="meta_key[]" placeholder="Atributo (Ej: Material)" required class="w-full text-sm rounded-md border border-gray-300 px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>
                <div class="flex-1">
                    <input type="text" name="meta_value[]" placeholder="Valor (Ej: Plástico)" required class="w-full text-sm rounded-md border border-gray-300 px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>
                <button type="button" class="remove-attr text-gray-400 hover:text-red-500 p-2 focus:outline-none transition-colors" title="Eliminar atributo">
                    <i class="fas fa-trash"></i>
                </button>
            `;
            
            container.appendChild(row);
            
            row.querySelector('.remove-attr').addEventListener('click', function() {
                container.removeChild(row);
                if (container.children.length === 1 && emptyMsg) { 
                    emptyMsg.style.display = 'block';
                }
            });
        });

        // UNIT ENGINE LOGIC
        const typeSelect = document.getElementById('measurement_type');
        const pUnitSelect = document.getElementById('purchase_unit_id');
        const cUnitSelect = document.getElementById('contained_unit_id');
        const sUnitSelect = document.getElementById('sale_unit_id');
        const bUnitInput = document.getElementById('base_unit_id');
        
        const costInput = document.getElementById('total_cost');
        const contentInput = document.getElementById('content_per_purchase');
        const priceInput = document.getElementById('sale_price');
        const marginInput = document.getElementById('profit_margin');
        const allowFrac = document.getElementById('allow_fractional');

        const contentSection = document.getElementById('content_section');
        const calcDisplay = document.getElementById('normalized_cost_display');
        const calcCostText = document.getElementById('calc_cost');
        const stockLabel = document.getElementById('stock_label');

        function populateSelects(family) {
            const filteredUnits = units.filter(u => u.base_type === family);
            let optionsHTML = '';
            filteredUnits.forEach(u => {
                optionsHTML += `<option value="${u.id}" data-base="${u.base_unit_id}" data-conv="${u.conversion_to_base}">${u.name} (${u.abbreviation})</option>`;
            });

            pUnitSelect.innerHTML = optionsHTML;
            cUnitSelect.innerHTML = optionsHTML;
            sUnitSelect.innerHTML = optionsHTML;
            
            // Set reasonable defaults
            if (family === 'peso') {
                selectOptionByAbbr(cUnitSelect, 'kg');
                selectOptionByAbbr(sUnitSelect, 'kg');
                selectOptionByAbbr(pUnitSelect, 'sc50');
            } else if (family === 'volumen') {
                selectOptionByAbbr(cUnitSelect, 'L');
                selectOptionByAbbr(sUnitSelect, 'L');
            } else {
                selectOptionByAbbr(cUnitSelect, 'und');
                selectOptionByAbbr(sUnitSelect, 'und');
                selectOptionByAbbr(pUnitSelect, 'und');
            }
        }

        function selectOptionByAbbr(select, abbr) {
            for(let i = 0; i < select.options.length; i++) {
                if(select.options[i].text.includes('('+abbr+')')) {
                    select.selectedIndex = i;
                    break;
                }
            }
        }

        function updateUI() {
            const family = typeSelect.value;
            
            if (family === 'unidad') {
                allowFrac.disabled = true;
            } else {
                allowFrac.disabled = false;
            }
            
            contentSection.classList.remove('hidden');
            
            const pOpt = pUnitSelect.options[pUnitSelect.selectedIndex];
            const purchaseName = pOpt ? pOpt.text.split(' ')[0] : 'Unidad';
            
            document.getElementById('cost_label').innerText = `Costo por ${purchaseName}:`;
            document.getElementById('content_label').innerText = `Unidades por ${purchaseName}:`;

            // Update Stock label
            const sOpt = sUnitSelect.options[sUnitSelect.selectedIndex];
            stockLabel.innerText = `Stock Inicial (en ${sOpt ? sOpt.text : ''})`;

            // Set base unit hidden input
            if(sOpt) bUnitInput.value = sOpt.dataset.base;

            calculateCost();
        }

        function calculateCost() {
            const totalCost = parseFloat(costInput.value) || 0;
            const contentAmount = parseFloat(contentInput.value) || 1;
            
            const cOpt = cUnitSelect.options[cUnitSelect.selectedIndex];
            const sOpt = sUnitSelect.options[sUnitSelect.selectedIndex];
            
            if(!cOpt || !sOpt) return;

            const cConv = parseFloat(cOpt.dataset.conv);
            const sConv = parseFloat(sOpt.dataset.conv);

            // Cost per base unit
            const contentInBase = contentAmount * cConv;
            const costPerBase = contentInBase > 0 ? (totalCost / contentInBase) : 0;
            
            // Cost per sale unit
            const costPerSale = costPerBase * sConv;
            
            calcDisplay.classList.remove('hidden');
            const pOpt = pUnitSelect.options[pUnitSelect.selectedIndex];
            
            let html = `El ${pOpt.text} cuesta $${totalCost.toFixed(2)}. `;
            html += `Contiene ${contentAmount} ${cOpt.text}.<br>`;
            html += `Costo normalizado: <b>$${costPerSale.toFixed(2)} / ${sOpt.text}</b>`;
            
            calcCostText.innerHTML = html;
            calcCostText.dataset.costPerSale = costPerSale;

            calculatePrice('cost');
        }

        function calculatePrice(source = null) {
            const costPerSale = parseFloat(calcCostText.dataset.costPerSale) || 0;
            
            if (source === 'cost' || source === 'margin' || document.activeElement === marginInput) {
                const margin = parseFloat(marginInput.value) || 0;
                const newPrice = costPerSale > 0 ? costPerSale * (1 + (margin / 100)) : 0;
                if(newPrice > 0 || source !== 'cost') priceInput.value = newPrice.toFixed(2);
            } else if (source === 'price' || document.activeElement === priceInput) {
                const price = parseFloat(priceInput.value) || 0;
                const newMargin = costPerSale > 0 ? ((price / costPerSale) - 1) * 100 : 0;
                marginInput.value = newMargin.toFixed(2);
            }
        }

        typeSelect.addEventListener('change', () => {
            populateSelects(typeSelect.value);
            updateUI();
        });

        pUnitSelect.addEventListener('change', updateUI);
        cUnitSelect.addEventListener('change', updateUI);
        sUnitSelect.addEventListener('change', updateUI);
        costInput.addEventListener('input', updateUI);
        contentInput.addEventListener('input', updateUI);
        
        marginInput.addEventListener('input', () => calculatePrice('margin'));
        priceInput.addEventListener('input', () => calculatePrice('price'));

        // Form submission with AJAX and SweetAlert
        const form = document.querySelector('form');
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(form);
            
            // Basic validation
            if (!formData.get('name')) {
                Swal.fire('Error', 'El nombre es obligatorio', 'error');
                return;
            }
            if (parseFloat(formData.get('price')) < 0) {
                Swal.fire('Error', 'El precio no puede ser negativo', 'error');
                return;
            }
            
            // Submit
            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'HX-Request': 'true' }
            })
            .then(async response => {
                if(response.ok) {
                    Swal.fire({
                        title: '¡Guardado Exitoso!',
                        text: 'El producto se ha guardado correctamente en el inventario.',
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: true,
                        confirmButtonText: 'Continuar',
                        confirmButtonColor: '#10b981',
                    }).then(() => {
                        window.location.href = '<?= BASE_URL ?>inventory';
                    });
                } else {
                    const text = await response.text();
                    Swal.fire('Error al guardar', text || 'Hubo un problema al guardar el producto', 'error');
                }
            })
            .catch(error => {
                Swal.fire('Error', 'Hubo un error de red al intentar guardar.', 'error');
            });
        });

        // Init
        populateSelects(typeSelect.value);
        updateUI();
    });
</script>

<style>
@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}
.animate-fade-in-up {
    animation: fadeInUp 0.3s ease-out forwards;
}
</style>

